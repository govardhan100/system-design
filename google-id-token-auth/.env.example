# Google ID Token Authentication Demo Configuration
APP_PORT=8005

# Optional: Set your real Google Cloud OAuth 2.0 Web Client ID
# Example: 123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
# Leave blank to use Demo / Simulator mode out of the box
GOOGLE_CLIENT_ID=

# Application Secret Key for issuing localhost session tokens
SESSION_SECRET=super-secret-localhost-session-key-change-in-prod
